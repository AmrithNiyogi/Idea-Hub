# Empty = same-origin /api/v1 (Vite proxies /api → uvicorn). Prefer this for local
# and for HTTPS ngrok frontends so the browser never hits http://localhost:8000
# (mixed content). Set an absolute origin only when the API is on another host.
VITE_API_BASE_URL=
# Agents / skills may also use IDEA_HUB_API_URL (same origin) — see docs/AGENT_HANDOFF.md.

# Microsoft Entra ID button on /login. Set false to hide even if API reports microsoft:true.
# When unset, the login page probes GET /api/v1/auth/providers.
VITE_MICROSOFT_AUTH_ENABLED=
