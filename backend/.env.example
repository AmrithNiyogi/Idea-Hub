# Copy to backend/.env and adjust as needed.
# Ports match scripts/dev-services.sh (isolated local Postgres/Redis under .dev/).
ENV=dev
APP_NAME=Idea Hub
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173
# Public API origin embedded in agent handoff prompts / skill install (no trailing slash).
PUBLIC_API_URL=http://127.0.0.1:8000

DATABASE_URL=postgresql+asyncpg://ideahub:ideahub@127.0.0.1:15432/ideahub
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET_KEY=IdeaHubDevSecretChangeMe!2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

LOGIN_OTP_TTL_SECONDS=600
LOGIN_OTP_MAX_ATTEMPTS=5
LOGIN_OTP_RESEND_COOLDOWN_SECONDS=60

# SMTP for login OTP (STARTTLS). Put real credentials only in backend/.env (gitignored).
SMTP_HOST=smtp.example.com
SMTP_PORT=588
SMTP_SECURITY=STARTTLS
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@example.com
# When set, every OTP is delivered here (login account still authenticated; named in body).
OTP_EMAIL_OVERRIDE=ops@example.com

# Domain-event notification emails (decisions, collab, hours, review assigned, …).
NOTIFY_EMAIL_ENABLED=true
# When set, every notification email is delivered here (intended recipient named in body).
# Falls back to OTP_EMAIL_OVERRIDE when empty.
NOTIFY_EMAIL_OVERRIDE=ops@example.com

# Local browser cookies: secure=false + samesite=lax.
# Cross-site (separate API host over HTTPS): secure=true + samesite=none.
# Same-origin via Vite proxy (recommended for ngrok UI): secure=false + lax is fine.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

SEED_PASSWORD=IdeaHub!2026

# Agents: true = local heuristic stubs (no Kompass HTTP). Flip false after
# AgentGateway gains a live Kompass adapter — see docs/AGENT_SIMULATION.md.
SIMULATE_AGENTS=true

# Local avatar uploads (served at /uploads/…)
UPLOAD_DIR=uploads

# Browser CORS. FRONTEND_ORIGIN is always allowed; add extras (comma-separated).
# Example with ngrok UI: FRONTEND_ORIGIN=https://<subdomain>.ngrok-free.app
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=

# Microsoft Entra ID / Azure AD OIDC (work & school accounts — M365 / Teams users).
# Leave ENABLED=false and secrets empty until Azure app registration is ready.
# Setup steps: docs/MICROSOFT_SSO.md
MICROSOFT_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Authority path segment: common | organizations | consumers | <tenant-GUID>
# - common: any Entra org + personal Microsoft accounts (demo-friendly)
# - organizations: any Entra work/school tenant only
# - <GUID>: single-tenant — only users in that directory (or invited guests)
# Env alone is not enough: Azure "Supported account types" must match (see docs).
MICROSOFT_TENANT_ID=common
# Must match an Azure "Web" redirect URI exactly.
# Local API: http://localhost:8000/api/v1/auth/microsoft/callback
# Ngrok UI + Vite /api proxy: https://<subdomain>.ngrok-free.app/api/v1/auth/microsoft/callback
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback
MICROSOFT_FRONTEND_SUCCESS_URL=http://localhost:5173/
MICROSOFT_DEFAULT_ROLE=contributor
MICROSOFT_SSO_STATE_TTL_SECONDS=600
