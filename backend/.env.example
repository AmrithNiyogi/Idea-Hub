# Copy to backend/.env and adjust as needed.
# Ports match scripts/dev-services.sh (isolated local Postgres/Redis under .dev/).
ENV=dev
APP_NAME=IdeaKonnekt
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173
# Public API origin embedded in agent handoff prompts / skill install (no trailing slash).
PUBLIC_API_URL=http://127.0.0.1:8000

DATABASE_URL=postgresql+asyncpg://ideahub:ideahub@127.0.0.1:15432/ideahub
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET_KEY=IdeaHubDevSecretChangeMe!2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

LOGIN_OTP_TTL_SECONDS=600
LOGIN_OTP_MAX_ATTEMPTS=5
LOGIN_OTP_RESEND_COOLDOWN_SECONDS=60
LOGIN_TICKET_TTL_SECONDS=300

# SMTP for login OTP (STARTTLS). Put real credentials only in backend/.env (gitignored).
SMTP_HOST=smtp.example.com
SMTP_PORT=588
SMTP_SECURITY=STARTTLS
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@example.com
# When set, every OTP is delivered here (login account still authenticated; named in body).
OTP_EMAIL_OVERRIDE=ops@example.com

# Domain-event notification emails (decisions, collab, hours, review assigned, …).
NOTIFY_EMAIL_ENABLED=true
# When set, every notification email is delivered here (intended recipient named in body).
# Falls back to OTP_EMAIL_OVERRIDE when empty.
NOTIFY_EMAIL_OVERRIDE=ops@example.com

# Local browser cookies: secure=false + samesite=lax.
# Cross-site (separate API host over HTTPS): secure=true + samesite=none.
# Same-origin via Vite proxy (recommended for ngrok UI): secure=false + lax is fine.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

SEED_PASSWORD=IdeaHub!2026

# Agents: true = local heuristic stubs (no AI Studio HTTP).
# Flip false only after AISTUDIO_* below is filled and agents exist in Kompass.
# See docs/AGENT_SIMULATION.md and docs/KOMPASS_PROMPT_CREATE_API.md.
SIMULATE_AGENTS=false

# AI Studio / Kompass API Gateway — POST /api/v2/runs/execute
# Staging example host (no trailing slash). Leave blank to force stubs.
AISTUDIO_API_BASE_URL=https://aistudio-apigateway-v2-staging.dotkonnekt.com
AISTUDIO_TENANT_ID=devtest
# Public/project-scoped execute: required header `project-slug`.
AISTUDIO_PROJECT_SLUG=ideakonnekt-idea-hub
# Optional: forwarded as `X-Authorization` when a tool needs its own auth.
# Never commit real tokens; never send this header from the browser.
AISTUDIO_TOOL_AUTH_TOKEN=
AISTUDIO_EXECUTE_TIMEOUT_SECONDS=120
# Kompass prompt/agent slugs per IdeaKonnekt surface (names from docs/KOMPASS_AGENT_PROMPTS.md).
AISTUDIO_AGENT_SUBMIT_ASSIST=idea-konnekt-submit-assist
AISTUDIO_AGENT_HELP=ideakonnekt-support-agent
AISTUDIO_AGENT_IDEA_OPTIMIZER=ideakonnekt-wf-idea-optimizer
AISTUDIO_AGENT_REVIEW_INTELLIGENCE=ideakonnekt-wf-review-intelligence
# Optional: Idea → Agent Build Loop (accepted ideas). Empty → simulated path.
AISTUDIO_AGENT_CODING_BUILD=ideakonnekt-wf-coding-agent-build
# Ideathon agents (Cluster, Rank, Pitch, Draft). Empty → that feature is disabled.
AISTUDIO_AGENT_IDEATHON_CLUSTER=ideakonnekt-ideathon-cluster
AISTUDIO_AGENT_IDEATHON_RANK=f5d7f69e-c414-4f45-9183-136ac53b0f0e
AISTUDIO_AGENT_IDEATHON_PITCH=48a8b05d-5b26-485d-a5cd-9a4df7105fd7
AISTUDIO_AGENT_IDEATHON_DRAFT=ideathon-draft
# Workflow slugs for Flow A (assist on submit): Intelligence first, then Enhancement.
AISTUDIO_WORKFLOW_IDEA_INTELLIGENCE=ideakonnekt-wf-idea-intelligence
AISTUDIO_WORKFLOW_IDEA_ENHANCEMENT=ideakonnekt-wf-idea-enhancement

# Local avatar uploads (served at /uploads/…)
UPLOAD_DIR=uploads

# Browser CORS. FRONTEND_ORIGIN is always allowed; add extras (comma-separated).
# Example with ngrok UI: FRONTEND_ORIGIN=https://<subdomain>.ngrok-free.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Microsoft Entra ID / Azure AD OIDC (work & school accounts — M365 / Teams users).
# Leave ENABLED=false and secrets empty until Azure app registration is ready.
# Setup steps: docs/MICROSOFT_SSO.md
MICROSOFT_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Authority path segment: common | organizations | consumers | <tenant-GUID>
# - common: any Entra org + personal Microsoft accounts (demo-friendly)
# - organizations: any Entra work/school tenant only
# - <GUID>: single-tenant — only users in that directory (or invited guests)
# Env alone is not enough: Azure "Supported account types" must match (see docs).
MICROSOFT_TENANT_ID=common
# Must match an Azure "Web" redirect URI exactly.
# Local API: http://localhost:8000/api/v1/auth/microsoft/callback
# Ngrok UI + Vite /api proxy: https://<subdomain>.ngrok-free.app/api/v1/auth/microsoft/callback
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback
MICROSOFT_FRONTEND_SUCCESS_URL=http://localhost:5173/
MICROSOFT_DEFAULT_ROLE=contributor
MICROSOFT_SSO_STATE_TTL_SECONDS=600

# ---------------------------------------------------------------------------
# Integrations / external trackers + Notion docs + Teams webhook
# ---------------------------------------------------------------------------
# Connect under UI → Integrations (personal) or org defaults (admin).
# Delivery uses the effective connection (user override → org default).
# Credentials are Fernet-encrypted at rest (key derived from JWT_SECRET_KEY).
# Do not put personal API tokens, Notion secrets, or Teams webhook URLs here.
#
# Teams: paste Incoming Webhook URL in UI (Integrations → Microsoft Teams).
# Team channels / meetings / custom MCP: docs/TEAM_SPACE.md
#
# Optional OAuth app credentials for a future OAuth connect flow:
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# Notion public OAuth (optional; MVP uses Internal Integration Secret in UI):
# Create at https://www.notion.so/my-integrations — for OAuth, use a public
# integration and set redirect URI to match NOTION_REDIRECT_URI below.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8000/api/v1/integrations/notion/oauth/callback
# Optional defaults for local demos of the custom_webhook provider
# (the UI still collects webhook_url per connection):
TRACKER_CUSTOM_WEBHOOK_URL=
TRACKER_CUSTOM_AUTH_HEADER=
# See docs/INTEGRATIONS.md and docs/TRACKER_PROVIDERS.md.
